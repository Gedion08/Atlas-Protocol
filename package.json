{
  "name": "atlas-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "The decentralized operating system for professional liquidity providers",
  "scripts": {
    "dev:frontend": "pnpm --filter atlas-frontend dev",
    "dev:backend": "pnpm --filter atlas-backend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "db:migrate": "pnpm --filter atlas-backend db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0"
}
