{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "atlas-types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts", "eslint.config.mjs"]
}
