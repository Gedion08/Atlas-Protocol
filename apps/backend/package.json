{
  "name": "atlas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm --filter atlas-types build && pnpm --filter strategy-sdk build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/postgres.integration.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap:devnet": "tsx scripts/bootstrap.ts",
    "e2e:devnet": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "atlas-types": "workspace:*",
    "bs58": "^6.0.0",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "strategy-sdk": "workspace:*",
    "tsx": "^4.23.12",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "typescript-eslint": "^8.67.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
